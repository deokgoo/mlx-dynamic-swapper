#!/usr/bin/env bash
# MLX Server Control CLI (with Dynamic Swapper Support)

PLIST_PATH="$HOME/Library/LaunchAgents/ai.mlx.server.plist"
MANAGER_LOG="$HOME/.mlx-server/manager.log"
MANAGER_ERR="$HOME/.mlx-server/manager.error.log"
SERVER_LOG="$HOME/.mlx-server/server.log"
SERVER_ERR="$HOME/.mlx-server/server.error.log"
COMPACT_LOG="$HOME/.mlx-server/compaction.log"
COMPACT_ERR="$HOME/.mlx-server/compaction.error.log"

PORT_MAIN=1234
PORT_COMPACT=1235
PORT_LAYA=1236

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

is_running() {
    lsof -i :$PORT_MAIN -sTCP:LISTEN >/dev/null 2>&1
}

is_laya_running() {
    lsof -i :$PORT_LAYA -sTCP:LISTEN >/dev/null 2>&1
}

get_manager_pid() {
    local pid
    pid=$(pgrep -x "mlx-swapper" | head -n 1)
    if [ -n "$pid" ]; then
        echo "$pid"
        return
    fi
    pgrep -f "mlx_manager.py" | head -n 1
}

get_main_pid() {
    pgrep -f "mlx.*\.server.*--port 18234" | head -n 1
}

get_compact_pid() {
    pgrep -f "mlx.*\.server.*--port 18235" | head -n 1
}

start_mlx() {
    if is_running; then
        echo -e "${YELLOW}MLX Manager is already running.${NC}"
        status_mlx
        return 0
    fi

    echo -e "${CYAN}Starting MLX Dynamic Swapper Manager...${NC}"
    launchctl bootout gui/$(id -u)/ai.mlx.server >/dev/null 2>&1 || launchctl unload "$PLIST_PATH" >/dev/null 2>&1
    launchctl bootstrap gui/$(id -u) "$PLIST_PATH" >/dev/null 2>&1 || launchctl load "$PLIST_PATH" >/dev/null 2>&1

    for i in {1..20}; do
        if is_running; then
            echo -e "${GREEN}✔ MLX Manager & Models are UP!${NC}"
            status_mlx
            return 0
        fi
        sleep 0.5
    done

    echo -e "${RED}✖ Failed to start MLX server within 10 seconds.${NC}"
    echo "Check logs: mlx logs"
    return 1
}

stop_mlx() {
    echo -e "${CYAN}Stopping MLX Server & Manager...${NC}"
    launchctl bootout gui/$(id -u)/ai.mlx.server >/dev/null 2>&1 || launchctl unload "$PLIST_PATH" >/dev/null 2>&1
    pkill -x "mlx-swapper" >/dev/null 2>&1
    pkill -f "mlx_manager.py" >/dev/null 2>&1
    pkill -f "mlx.*\.server" >/dev/null 2>&1
    sleep 1

    if ! is_running; then
        echo -e "${GREEN}✔ MLX Manager & Models stopped. VRAM/RAM 100% freed.${NC}"
    else
        pkill -9 -x "mlx-swapper" >/dev/null 2>&1
        pkill -9 -f "mlx_manager.py" >/dev/null 2>&1
        pkill -9 -f "mlx.*\.server" >/dev/null 2>&1
        echo -e "${YELLOW}✔ MLX Server force-killed. RAM freed.${NC}"
    fi
}

status_mlx() {
    M_PID=$(get_manager_pid)

    if [ -n "$M_PID" ] && is_running; then
        M_CMD=$(ps -o comm= -p "$M_PID" 2>/dev/null)
        if [[ "$M_CMD" == *"mlx-swapper"* ]]; then
            ENGINE="${CYAN}Rust Native${NC}"
        else
            ENGINE="${YELLOW}Python${NC}"
        fi
        M_RSS=$(ps -o rss= -p "$M_PID" 2>/dev/null | tr -d ' ')
        M_RAM_MB=$((M_RSS / 1024))
        echo -e "${BOLD}MLX Dynamic Swapper:${NC} ${GREEN}ONLINE${NC} (Engine: ${ENGINE}, PID: $M_PID, RAM: ${M_RAM_MB}MB)"
        echo -e "  Main (Qwen3.8-27B MTP):       http://127.0.0.1:${PORT_MAIN}/v1"
        echo -e "  Compactor (Gemma4-26B-A4B):   http://127.0.0.1:${PORT_COMPACT}/v1"
        if is_laya_running; then
            echo -e "  Laya Endpoint:                ${GREEN}http://127.0.0.1:${PORT_LAYA}/v1 (resident)${NC}"
        else
            echo -e "  Laya Endpoint:                ${YELLOW}DISABLED (ENABLE_LAYA=0)${NC}"
        fi
        echo ""

        # Try getting live active models from swapper API
        STATUS_JSON=$(curl -s --max-time 1 "http://127.0.0.1:${PORT_MAIN}/status" 2>/dev/null)
        ACTIVE_NAME=""
        ACTIVE_PID=""

        if [ -n "$STATUS_JSON" ]; then
            ACTIVE_NAME=$(echo "$STATUS_JSON" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("active_models", [{}])[0].get("name", ""))' 2>/dev/null)
            ACTIVE_PID=$(echo "$STATUS_JSON" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("active_models", [{}])[0].get("pid", ""))' 2>/dev/null)
        fi

        # Fallback to process search if API did not return model
        if [ -z "$ACTIVE_PID" ] || [ "$ACTIVE_PID" = "None" ]; then
            PID_MAIN=$(get_main_pid)
            PID_COMPACT=$(get_compact_pid)
            if [ -n "$PID_MAIN" ]; then
                ACTIVE_NAME="Qwen3.8-27B MTP (Main, 18234)"
                ACTIVE_PID="$PID_MAIN"
            elif [ -n "$PID_COMPACT" ]; then
                ACTIVE_NAME="Gemma4-26B-A4B (Compactor, 18235)"
                ACTIVE_PID="$PID_COMPACT"
            fi
        fi

        if [ -n "$ACTIVE_PID" ] && [ "$ACTIVE_PID" != "None" ]; then
            RSS=$(ps -o rss= -p "$ACTIVE_PID" 2>/dev/null | tr -d ' ')
            RAM_MB=$((RSS / 1024))
            echo -e "  ${BOLD}Active Model:${NC}       ${GREEN}${ACTIVE_NAME}${NC}"
            echo -e "  Status:             Running (PID: ${ACTIVE_PID}, RAM: ${RAM_MB}MB)"
        else
            echo -e "  ${BOLD}Active Model:${NC}       ${YELLOW}Standby (Swapping on demand)${NC}"
        fi
        echo -e "  Auto-Swap Mode:     Active (Dynamically swapped between Main & Compactor)"
    else
        echo -e "Status: ${RED}OFFLINE${NC} (Ports free, RAM usage: 0MB)"
    fi
}

logs_mlx() {
    echo -e "${CYAN}Tailing MLX Server & Manager logs (Ctrl+C to exit)...${NC}"
    tail -f "$MANAGER_LOG" "$HOME/.mlx-server/main.log" "$HOME/.mlx-server/main.error.log" "$COMPACT_LOG"
}

health_mlx() {
    local ok=0
    if curl -s --max-time 5 http://127.0.0.1:${PORT_MAIN}/v1/models > /dev/null 2>&1; then
        ok=1
    fi
    if [ "$ok" -eq 1 ]; then
        echo "UP"
        return 0
    else
        echo "DOWN"
        return 1
    fi
}

laya_mlx() {
    # mlx laya "prompt" [--preset triage|email|guard|moderation|router]
    local prompt="$1"; shift || true
    local preset=""
    if [ "$1" = "--preset" ]; then
        preset="$2"; shift 2 || true
    fi
    if [ -z "$prompt" ]; then
        echo "Usage: mlx laya \"<text>\" [--preset <name>]"
        echo "  presets: triage, email, guard, moderation, router"
        return 1
    fi
    local url="http://127.0.0.1:${PORT_LAYA}/v1/predict"
    local body
    if [ -n "$preset" ]; then
        body=$(python3 -c "
import json, sys, urllib.request
state, preset = sys.argv[1], sys.argv[2]
try:
    presets = json.load(urllib.request.urlopen('http://127.0.0.1:${PORT_LAYA}/v1/presets', timeout=10))
except Exception as e:
    sys.exit(f'failed to fetch presets: {e}')
q = presets.get(preset)
if q is None:
    sys.exit('unknown preset: ' + preset + ' (available: ' + ', '.join(presets) + ')')
print(json.dumps({'state': state, 'questions': q}))
" "$prompt" "$preset") || { echo "$body"; return 1; }
    else
        body=$(python3 -c "
import json, sys
print(json.dumps({'state': sys.argv[1], 'questions': {'decision': {'type': 'noul', 'instructions': 'Is this actionable/urgent?'}}}))
" "$prompt")
    fi
    curl -s --max-time 30 -X POST "$url" -H "Content-Type: application/json" -d "$body" | python3 -m json.tool
}

top_mlx() {
    trap 'tput cnorm; echo ""; exit 0' INT TERM
    tput civis
    clear

    while true; do
        # clear 대신 커서 원위치로 덮어써서 터미널 깜빡임 0(No-Flicker) 달성
        tput cup 0 0
        local now=$(date +"%Y-%m-%d %H:%M:%S")
        echo -e "${BOLD}======================================================================${NC}"
        echo -e " 🚀 ${BOLD}MLX DYNAMIC SWAPPER LIVE DASHBOARD${NC}          ${CYAN}${now}${NC}"
        echo -e "${BOLD}======================================================================${NC}"

        local m_pid=$(get_manager_pid)
        if [ -n "$m_pid" ] && is_running; then
            local m_cmd=$(ps -o comm= -p "$m_pid" 2>/dev/null)
            local engine="Python"
            if [[ "$m_cmd" == *"mlx-swapper"* ]]; then
                engine="Rust Native"
            fi
            local m_rss=$(ps -o rss= -p "$m_pid" 2>/dev/null | tr -d ' ')
            local m_ram_mb=$((m_rss / 1024))
            echo -e " • ${BOLD}Swapper Daemon:${NC}   ${GREEN}ONLINE${NC} (Engine: ${CYAN}${engine}${NC}, PID: ${m_pid}, RAM: ${m_ram_mb}MB)"
        else
            echo -e " • ${BOLD}Swapper Daemon:${NC}   ${RED}OFFLINE${NC}"
        fi

        # ── System RAM Gauge (Accurate Memory Pressure) ───────────────
        local total_gb=36
        local free_pct=$(memory_pressure 2>/dev/null | grep -i "System-wide memory free percentage" | awk '{print $5}' | tr -d '%')
        local pct=70
        if [ -n "$free_pct" ]; then
            pct=$((100 - free_pct))
        fi
        local used_gb=$(awk "BEGIN {printf \"%.1f\", ($pct / 100) * $total_gb}")

        local bar_len=25
        local filled=$(awk "BEGIN {printf \"%.0f\", ($pct / 100) * $bar_len}")
        [ "$filled" -gt "$bar_len" ] && filled=$bar_len

        local bar=""
        for ((i=0; i<filled; i++)); do bar+="█"; done
        for ((i=filled; i<bar_len; i++)); do bar+="░"; done

        local bar_color="${GREEN}"
        local status_tag="쾌적 (안정)"
        if [ "$pct" -ge 90 ]; then
            bar_color="${RED}"
            status_tag="위험 (스왑 발생)"
        elif [ "$pct" -ge 80 ]; then
            bar_color="${YELLOW}"
            status_tag="주의 (압박)"
        fi

        echo -e " • ${BOLD}Apple M5 Max RAM:${NC} [${bar_color}${bar}${NC}] ${bar_color}${pct}%${NC} (${used_gb}GB / ${total_gb}GB) - ${bar_color}${status_tag}${NC}"
        echo -e "${BOLD}----------------------------------------------------------------------${NC}"

        # ── Model Matrix ────────────────────────────────────────────────
        local pid_main=$(get_main_pid)
        local pid_compact=$(get_compact_pid)
        local pid_comfy=$(pgrep -f "ComfyUI/main.py" | head -n 1)

        echo -e " ${BOLD}MODEL & BACKEND MATRIX:${NC}"

        # Main Model
        if [ -n "$pid_main" ]; then
            local main_rss=$(ps -o rss= -p "$pid_main" 2>/dev/null | tr -d ' ')
            local main_mb=$((main_rss / 1024))
            echo -e "   [1] ${BOLD}Qwen3.8-27B-4bit + MTP${NC}    ${GREEN}● ACTIVE${NC}   (Port 1234/18234, PID: ${pid_main}, RAM: ${main_mb}MB)"
        else
            echo -e "   [1] Qwen3.8-27B-4bit + MTP    ${YELLOW}○ STANDBY${NC}  (Port 1234)"
        fi

        # Compact Model
        if [ -n "$pid_compact" ]; then
            local comp_rss=$(ps -o rss= -p "$pid_compact" 2>/dev/null | tr -d ' ')
            local comp_mb=$((comp_rss / 1024))
            echo -e "   [2] ${BOLD}Gemma-4-26B-A4B MoE${NC}       ${GREEN}● ACTIVE${NC}   (Port 1235/18235, PID: ${pid_compact}, RAM: ${comp_mb}MB)"
        else
            echo -e "   [2] Gemma-4-26B-A4B MoE       ${YELLOW}○ STANDBY${NC}  (Port 1235 on-demand)"
        fi

        # ComfyUI
        if [ -n "$pid_comfy" ]; then
            local comfy_rss=$(ps -o rss= -p "$pid_comfy" 2>/dev/null | tr -d ' ')
            local comfy_mb=$((comfy_rss / 1024))
            echo -e "   [3] ${BOLD}ComfyUI Qwen-Image 2.1${NC}    ${GREEN}● ACTIVE${NC}   (Port 8188, PID: ${pid_comfy}, RAM: ${comfy_mb}MB)"
        else
            echo -e "   [3] ComfyUI Qwen-Image 2.1    ${YELLOW}○ STANDBY${NC}  (Port 8188 on-demand)"
        fi

        echo -e "${BOLD}----------------------------------------------------------------------${NC}"
        echo -e " • ${BOLD}Thinking Config:${NC}  ${CYAN}Balanced medium${NC} (~200 tokens, 1.5s latency)"
        echo -e " • ${BOLD}Acceleration:${NC}     ${CYAN}MTP Speculative Decoding${NC} (~43.7 tok/s, 81% accepted)"
        echo -e " • ${BOLD}Zero-OOM Swapper:${NC} Active (Mutual exclusion lock via Rust)"
        echo -e "${BOLD}======================================================================${NC}"
        echo -e " ${YELLOW}Press Ctrl+C to exit${NC}"
        sleep 1
    done
}

case "$1" in
    start|on)
        start_mlx
        ;;
    stop|off)
        stop_mlx
        ;;
    restart)
        stop_mlx
        sleep 1
        start_mlx
        ;;
    ""|status)
        status_mlx
        ;;
    health)
        health_mlx
        ;;
    laya)
        shift
        laya_mlx "$@"
        ;;
    logs|log)
        logs_mlx
        ;;
    top|watch)
        top_mlx
        ;;
    dashboard|web|ui)
        echo -e "${GREEN}🚀 Opening MLX Swapper React Dashboard...${NC}"
        open "http://127.0.0.1:1234/dashboard/"
        ;;
    *)
        echo "Usage: mlx {start|stop|restart|status|health|laya|logs|top|dashboard}"
        exit 1
        ;;
esac
