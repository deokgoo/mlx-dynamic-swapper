#!/usr/bin/env bash
# MLX Server Control CLI (with Dynamic Swapper Support)

PLIST_PATH="$HOME/Library/LaunchAgents/ai.mlx.server.plist"
MANAGER_LOG="$HOME/.mlx-server/manager.log"
MANAGER_ERR="$HOME/.mlx-server/manager.error.log"
SERVER_LOG="$HOME/.mlx-server/server.log"
SERVER_ERR="$HOME/.mlx-server/server.error.log"
COMPACT_LOG="$HOME/.mlx-server/compaction.log"
COMPACT_ERR="$HOME/.mlx-server/compaction.error.log"

PORT_MAIN=1234
PORT_COMPACT=1235

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

is_running() {
    lsof -i :$PORT_MAIN -sTCP:LISTEN >/dev/null 2>&1
}

get_manager_pid() {
    pgrep -f "mlx_manager.py" | head -n 1
}

get_main_pid() {
    pgrep -f "mlx_lm.server.*--port 18234" | head -n 1
}

get_compact_pid() {
    pgrep -f "mlx_lm.server.*--port 18235" | head -n 1
}

start_mlx() {
    if is_running; then
        echo -e "${YELLOW}MLX Manager is already running.${NC}"
        status_mlx
        return 0
    fi

    echo -e "${CYAN}Starting MLX Dynamic Swapper Manager...${NC}"
    launchctl bootout gui/$(id -u)/ai.mlx.server >/dev/null 2>&1 || launchctl unload "$PLIST_PATH" >/dev/null 2>&1
    launchctl bootstrap gui/$(id -u) "$PLIST_PATH" >/dev/null 2>&1 || launchctl load "$PLIST_PATH" >/dev/null 2>&1

    for i in {1..20}; do
        if is_running; then
            echo -e "${GREEN}✔ MLX Manager & Models are UP!${NC}"
            status_mlx
            return 0
        fi
        sleep 0.5
    done

    echo -e "${RED}✖ Failed to start MLX server within 10 seconds.${NC}"
    echo "Check logs: mlx logs"
    return 1
}

stop_mlx() {
    echo -e "${CYAN}Stopping MLX Server & Manager...${NC}"
    launchctl bootout gui/$(id -u)/ai.mlx.server >/dev/null 2>&1 || launchctl unload "$PLIST_PATH" >/dev/null 2>&1
    pkill -f "mlx_manager.py" >/dev/null 2>&1
    pkill -f "mlx_lm.server" >/dev/null 2>&1
    sleep 1

    if ! is_running; then
        echo -e "${GREEN}✔ MLX Manager & Models stopped. VRAM/RAM 100% freed.${NC}"
    else
        pkill -9 -f "mlx_manager.py" >/dev/null 2>&1
        pkill -9 -f "mlx_lm.server" >/dev/null 2>&1
        echo -e "${YELLOW}✔ MLX Server force-killed. RAM freed.${NC}"
    fi
}

status_mlx() {
    M_PID=$(get_manager_pid)
    PID_MAIN=$(get_main_pid)
    PID_COMPACT=$(get_compact_pid)

    if [ -n "$M_PID" ] && is_running; then
        echo -e "${BOLD}MLX Dynamic Swapper:${NC} ${GREEN}ONLINE${NC} (Manager PID: $M_PID)"
        echo -e "  Main Endpoint:       http://127.0.0.1:${PORT_MAIN}/v1"
        echo -e "  Compaction Endpoint: http://127.0.0.1:${PORT_COMPACT}/v1"
        echo ""

        if [ -n "$PID_MAIN" ]; then
            RSS=$(ps -o rss= -p "$PID_MAIN" 2>/dev/null | tr -d ' ')
            RAM_MB=$((RSS / 1024))
            echo -e "  ${BOLD}Active Model:${NC}       ${GREEN}Main Model (27B)${NC}"
            echo -e "  Status:             Running (PID: $PID_MAIN, RAM: ${RAM_MB}MB, Prompt Cache: 6GB)"
        elif [ -n "$PID_COMPACT" ]; then
            RSS=$(ps -o rss= -p "$PID_COMPACT" 2>/dev/null | tr -d ' ')
            RAM_MB=$((RSS / 1024))
            echo -e "  ${BOLD}Active Model:${NC}       ${YELLOW}Compaction Model (7B)${NC}"
            echo -e "  Status:             Running (PID: $PID_COMPACT, RAM: ${RAM_MB}MB, Full VRAM)"
        else
            echo -e "  ${BOLD}Active Model:${NC}       ${YELLOW}Standby (Swapping on demand)${NC}"
        fi
        echo -e "  Auto-Swap Mode:     Active (Main unloads on compaction, Compaction runs, then Main restores)"
    else
        echo -e "Status: ${RED}OFFLINE${NC} (Ports ${PORT_MAIN}/${PORT_COMPACT} free, RAM usage: 0MB)"
    fi
}

logs_mlx() {
    echo -e "${CYAN}Tailing MLX Server & Manager logs (Ctrl+C to exit)...${NC}"
    tail -f "$MANAGER_LOG" "$SERVER_LOG" "$COMPACT_LOG"
}

case "$1" in
    start|on)
        start_mlx
        ;;
    stop|off)
        stop_mlx
        ;;
    restart)
        stop_mlx
        sleep 1
        start_mlx
        ;;
    status)
        status_mlx
        ;;
    logs|log)
        logs_mlx
        ;;
    *)
        echo "Usage: mlx {start|stop|restart|status|logs}"
        exit 1
        ;;
esac
