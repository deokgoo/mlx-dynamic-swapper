<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.mlx.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{HOME}}/.mlx-server/bin/python</string>
        <string>{{HOME}}/.mlx-server/mlx_manager.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{HOME}}/.mlx-server</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.mlx-server/manager.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.mlx-server/manager.error.log</string>
</dict>
</plist>
